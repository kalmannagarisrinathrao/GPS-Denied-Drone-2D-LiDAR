Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
    - Class: rviz_default_plugins/PointCloud2
      Name: Walls seen (map so far)
      Enabled: true
      Topic:
        Value: /goto/map_points
        Depth: 1
        Reliability Policy: Reliable
        History Policy: Keep Last
        Durability Policy: Volatile
      Style: Flat Squares
      Size (m): 0.12
      Color Transformer: FlatColor
      Color: 140; 140; 150
      Alpha: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR now
      Enabled: true
      Topic:
        Value: /goto/scan_points
        Depth: 1
        Reliability Policy: Reliable
        History Policy: Keep Last
        Durability Policy: Volatile
      Style: Flat Squares
      Size (m): 0.1
      Color Transformer: FlatColor
      Color: 0; 220; 255
      Alpha: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Too close (under stop distance)
      Enabled: true
      Topic:
        Value: /goto/near_points
        Depth: 1
        Reliability Policy: Reliable
        History Policy: Keep Last
        Durability Policy: Volatile
      Style: Flat Squares
      Size (m): 0.2
      Color Transformer: FlatColor
      Color: 255; 30; 30
      Alpha: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Goal and travel direction
      Enabled: true
      Topic:
        Value: /goto/markers
        Depth: 5
        Reliability Policy: Reliable
        History Policy: Keep Last
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Pose
      Name: Drone
      Enabled: true
      Topic:
        Value: /goto/drone_pose
        Depth: 5
        Reliability Policy: Reliable
        History Policy: Keep Last
        Durability Policy: Volatile
      Shape: Arrow
      Color: 255; 25; 0
      Head Length: 0.6
      Head Radius: 0.3
      Shaft Length: 0.8
      Shaft Radius: 0.1
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 30
      X: 0
      Y: 0
    Saved: ~
